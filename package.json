{
  "name": "immo-ci",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "security:secrets": "gitleaks detect --source . --config .gitleaks.toml --no-git",
    "security:trivy": "trivy fs --scanners vuln,misconfig,secret --skip-dirs node_modules,.next,.turbo .",
    "security:sast": "eslint --config eslint.security.config.mjs \"apps/**/*.{ts,tsx,js}\"",
    "security:dep-check": "dependency-check.cmd --project immo --scan package-lock.json --out ./reports/dependency-check",
    "security:zap-gen": "zap.cmd -cmd -autogenmin zap-automation.yaml",
    "security:all": "npm run security:secrets && npm run security:trivy && npm run security:sast",
    "build:cloudflare": "turbo run build:cloudflare"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "esbuild": "^0.28.2",
    "eslint-plugin-security": "^4.2.0",
    "prettier": "^3.0.0",
    "turbo": "^2.10.12",
    "typescript": "6.0.2"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "react-hook-form": "^7.72.1",
    "react-native-web": "^0.21.2",
    "zod": "^4.3.6"
  }
}
