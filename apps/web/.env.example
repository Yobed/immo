# ═══════════════════════════════════════════════════════════════
# IMMO CI — Web Application Environment Variables
# Copy this file to .env.local and fill in actual values
# ═══════════════════════════════════════════════════════════════

# ─── SUPABASE (REQUIRED) ───────────────────────────────────────
# Get these from https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxx.xxxxx.xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx.xxxxx.xxxxx

# ─── CLOUDINARY (REQUIRED for image uploads) ───────────────────
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=xxxxx
CLOUDINARY_API_KEY=xxxxx
CLOUDINARY_API_SECRET=xxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=xxxxx

# ─── APPLICATION ──────────────────────────────────────────────
# Set to your production domain or localhost:3000 for development
NEXT_PUBLIC_SITE_URL=https://immo-ci.vercel.app
NEXT_PUBLIC_APP_URL=https://immo-ci.vercel.app
NEXT_PUBLIC_URL=https://immo-ci.vercel.app

# Node environment (development/production)
NODE_ENV=development

# ─── INTEGRATIONS (OPTIONAL) ──────────────────────────────────
# WhatsApp integration (Sapphire advisor phone number)
SAPPHIRE_ADVISOR_PHONE=2250700000000

# Cron job security token
CRON_SECRET=your-secret-cron-token

# Tally form webhook secret
TALLY_WEBHOOK_SECRET=your-tally-secret

# ─── ANALYTICS (OPTIONAL) ─────────────────────────────────────
# Google Analytics 4 ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel ID
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# ─── DEVELOPMENT ONLY ─────────────────────────────────────────
# Enable debug logging
DEBUG=false
